        scroll-padding-top: ${e};
      `}
  }

  body {
    margin: 0;
  }
  
  a {
    text-decoration: none;
  }

  // iOS webkit link element conversion overwriting local styles workaround
  p span > a[href^="tel:"] {
    color: inherit
  }
  
  p {
    margin: 0;
  }
  
  *, *:before, *:after {
    box-sizing: inherit
  }
  * {
    -webkit-font-smoothing: antialiased
  }
  // todo check blog/post/page titles
