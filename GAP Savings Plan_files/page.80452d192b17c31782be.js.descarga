ा  पेमेंट करें (केवल $9.95 यूएस, $19.95 अंतर्राष्ट्रीय)। आपकी जानकारी सुरक्षित है और इसे शेयर नहीं किया जाएगा।\\n\\nरिटेल प्राइस","default_shipping_text":"शिपिंग"},"step_payment":{"default_footer_text":"* 100% सुरक्षित और संरक्षित पेमेंट *\\n\\n","default_button_text":"मेरी बुक अभी भेजें!!!","default_button_sub_text":"स्टेप 2 बटन सबटेक्स्ट","default_headline":"स्टेप 2: ग्राहक चेकआउट","default_sub_headline":"हम आपकी फ्री ई बुक भेजने के लिए तैयार हैं!"}},"survey":{"final_step":{"default_call_to_action_text":"कॉल टू एक्शन ","put_your_form_title_here":"अपना फॉर्म टाइटल यहां डालें","sub_title":"अपनी व्यक्तिगत जानकारी के साथ फॉर्म भरें"},"default_question_title_text":"अपना प्रश्न यहाँ जोड़ें","default_question_sub_title_text":"अपने प्रश्न का विवरण यहाँ जोड़ें","default_answer_title_text":"उत्तर"},"carousel":{"empty_dropbox_text":"स्लाइड की कॉन्टेन्ट को ड्रैग और ड्रॉप  करें "},"faq":{"empty_dropbox_text":"अपना पहला एलीमेंट यहां खींचें और छोड़\\nड्रैग एंड ड्रॉप करें"},"blog_post_date":{"warnings":{"do_not_remove":"इस कम्पोनन्ट को ब्लॉग पोस्ट दिनांक से बदल दिया जाएगा, इसे न हटाएं"}},"blog_post_image":{"warnings":{"do_not_remove":"इस कम्पोनन्ट को ब्लॉग पोस्ट इमेज से बदल दिया जाएगा, इसे न हटाएं"}},"content_table":{"default_header_title":"कॉन्टेन्ट"},"textarea":{"contact_us_placeholder":"मैसेज "},"blog_category_title":{"example":"कैटेगरी टाइटल ","warnings":{"do_not_remove":"इस कम्पोनन्ट  को ब्लॉग के कैटेगरी टाइटल द्वारा बदल दिया  जाएगा, इसे न हटाएं"}},"blog_category_description":{"example":"ब्लॉग कैटेगरी विवरण","warnings":{"do_not_remove":"इस कम्पोनन्ट को ब्लॉग के कैटेगरी विवरण द्वारा बदल दिया जाएगा, इसे न हटाएं"}},"subject":{"contact_us_placeholder":"विषय"},"shipping_fees":{"example_warning":"यह एक उदहारण है। शिपिंग रेट कस्टमर के ऑर्डर की प्राइस और देश के अनुसार कॅल्क्यूलेट किए जायेंगे। "},"calendar":{"example_warning":"यह एक सैंपल इवेंट है। कृपया इसे पब्लिक पेज पर प्रदर्शित करने के लिए सेटिंग्स में एक इवेंट चुनें।","form_submit_default_text":"जमा करें","next_step_default_text